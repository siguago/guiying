{
  "$description": "归影桌面端设计令牌。冷中性照片工作台让内容、保留选择和可恢复隔离成为视觉主角；中文仅作为本地化约束，不决定艺术风格。",
  "reference": {
    "color": {
      "neutral": {
        "canvas": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.960784, 0.968627, 0.980392], "alpha": 1, "hex": "#f5f7fa" }
        },
        "surface": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" }
        },
        "muted": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.92549, 0.941176, 0.960784], "alpha": 1, "hex": "#ecf0f5" }
        }
      },
      "slate": {
        "strong": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.094118, 0.12549, 0.168627], "alpha": 1, "hex": "#18202b" }
        },
        "muted": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.321569, 0.376471, 0.435294], "alpha": 1, "hex": "#52606f" }
        }
      },
      "line": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.815686, 0.847059, 0.886275], "alpha": 1, "hex": "#d0d8e2" }
      },
      "blue": {
        "600": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.192157, 0.360784, 0.956863], "alpha": 1, "hex": "#315cf4" }
        },
        "800": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.117647, 0.235294, 0.698039], "alpha": 1, "hex": "#1e3cb2" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.901961, 0.92549, 1], "alpha": 1, "hex": "#e6ecff" }
        }
      },
      "violet": {
        "600": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.403922, 0.337255, 0.85098], "alpha": 1, "hex": "#6756d9" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.92549, 0.917647, 1], "alpha": 1, "hex": "#eceaff" }
        }
      },
      "emerald": {
        "700": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.086275, 0.47451, 0.298039], "alpha": 1, "hex": "#16794c" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.870588, 0.968627, 0.913725], "alpha": 1, "hex": "#def7e9" }
        }
      },
      "amber": {
        "600": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.658824, 0.372549, 0], "alpha": 1, "hex": "#a85f00" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [1, 0.937255, 0.827451], "alpha": 1, "hex": "#ffefd3" }
        }
      },
      "red": {
        "600": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.768627, 0.239216, 0.294118], "alpha": 1, "hex": "#c43d4b" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [1, 0.901961, 0.913725], "alpha": 1, "hex": "#ffe6e9" }
        }
      },
      "white": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" }
      }
    },
    "font": {
      "interface": {
        "$type": "fontFamily",
        "$value": ["-apple-system", "BlinkMacSystemFont", "PingFang SC", "Noto Sans CJK SC", "Segoe UI", "sans-serif"]
      },
      "numeric": {
        "$type": "fontFamily",
        "$value": ["SFMono-Regular", "Cascadia Mono", "Roboto Mono", "monospace"]
      }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "small": { "$value": { "value": 6, "unit": "px" } },
      "medium": { "$value": { "value": 10, "unit": "px" } },
      "large": { "$value": { "value": 14, "unit": "px" } }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
      "standard": { "$type": "duration", "$value": { "value": 220, "unit": "ms" } },
      "deliberate": { "$type": "duration", "$value": { "value": 420, "unit": "ms" } },
      "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$type": "color", "$value": "{reference.color.neutral.canvas}" },
      "primary": { "$type": "color", "$value": "{reference.color.neutral.surface}" },
      "secondary": { "$type": "color", "$value": "{reference.color.neutral.muted}" },
      "selected": { "$type": "color", "$value": "{reference.color.blue.100}" },
      "warning": { "$type": "color", "$value": "{reference.color.amber.100}" },
      "danger": { "$type": "color", "$value": "{reference.color.red.100}" }
    },
    "track": {
      "keep": { "$type": "color", "$value": "{reference.color.emerald.700}" },
      "keepSurface": { "$type": "color", "$value": "{reference.color.emerald.100}" },
      "move": { "$type": "color", "$value": "{reference.color.violet.600}" },
      "moveSurface": { "$type": "color", "$value": "{reference.color.violet.100}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{reference.color.slate.strong}" },
      "secondary": { "$type": "color", "$value": "{reference.color.slate.muted}" },
      "inverse": { "$type": "color", "$value": "{reference.color.white}" },
      "positive": { "$type": "color", "$value": "{reference.color.emerald.700}" },
      "warning": { "$type": "color", "$value": "{reference.color.amber.600}" },
      "danger": { "$type": "color", "$value": "{reference.color.red.600}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{reference.color.line}" },
      "strong": { "$type": "color", "$value": "{reference.color.slate.muted}" },
      "focus": { "$type": "color", "$value": "{reference.color.blue.600}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{reference.color.blue.600}" },
      "primaryHover": { "$type": "color", "$value": "{reference.color.blue.800}" },
      "danger": { "$type": "color", "$value": "{reference.color.red.600}" }
    },
    "font": {
      "interface": { "$type": "fontFamily", "$value": "{reference.font.interface}" },
      "numeric": { "$type": "fontFamily", "$value": "{reference.font.numeric}" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "{reference.radius.small}" },
      "surface": { "$type": "dimension", "$value": "{reference.radius.medium}" },
      "overlay": { "$type": "dimension", "$value": "{reference.radius.large}" }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "{reference.motion.fast}" },
      "standard": { "$type": "duration", "$value": "{reference.motion.standard}" },
      "deliberate": { "$type": "duration", "$value": "{reference.motion.deliberate}" },
      "ease": { "$type": "cubicBezier", "$value": "{reference.motion.ease}" }
    }
  }
}
